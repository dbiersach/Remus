# Standardize line endings across every machine that touches this
# repository. Text files are stored and checked out with LF, so scripts
# never show phantom CRLF diffs. It matters most for the shell installer:
# a CRLF shebang line breaks execution on Linux with a misleading
# "bad interpreter" error.
* text=auto eol=lf

# The diff=python driver makes `git diff` show the enclosing function in
# the hunk header instead of a bare line number.
*.py    text eol=lf diff=python

# Shell scripts must be LF or Linux refuses to run them.
*.sh text eol=lf

# PowerShell reads LF fine on both Windows PowerShell and PowerShell 7.
*.ps1 text eol=lf

# Windows batch files are the one exception: cmd.exe mis-parses labels and
# multi-line blocks when the file uses LF, so force CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Project configuration.
*.code-workspace text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md   text eol=lf

# Chess data files are plain text.
*.pgn text eol=lf
*.fen text eol=lf
*.epd text eol=lf
