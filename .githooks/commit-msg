#!/bin/sh
# Refuse a commit whose message or author credits an AI tool. CLAUDE.md asks
# that every commit read as the repository owner's own work. Turn the hook on
# once per clone with: git config core.hooksPath .githooks

pattern='co-authored-by:.*(claude|anthropic|openai|chatgpt|copilot)|generated (with|by) .*(claude|chatgpt|copilot)|claude-session:|claude-projects-attribution|claude\.ai/code|noreply@anthropic\.com|🤖'

if grep -Eiq "$pattern" "$1"; then
    echo "commit-msg: the message credits an AI tool:" >&2
    grep -Ein "$pattern" "$1" >&2
    exit 1
fi

for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
    if echo "$ident" | grep -Eiq 'anthropic|claude'; then
        echo "commit-msg: the commit would be made as \"$ident\"." >&2
        echo 'Run: git config user.name "David Biersach"' >&2
        echo '     git config user.email "dbiersach@gmail.com"' >&2
        exit 1
    fi
done
